# Dependencies
node_modules/

# WXT build output and generated types
.output/
.wxt/
test-builds/
web-ext-artifacts/
stats.html
stats-*.json

# Packaged extensions
*.zip
*.xpi
*.crx
*.pem

# Tests and coverage
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Caches and logs
.eslintcache
.cache/
*.log
npm-debug.log*
pnpm-debug.log*

# Environment and secrets (an optional GitHub token must never be committed)
.env
.env.*
!.env.example

# Local Claude Code state
.claude/
CLAUDE.local.md

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# Generation logs from artwork tooling
agy-*.log

# Raw research captures: kept locally, never published (GitHub pages, response headers,
# GitHub's own JS bundles). Only the README describing them is tracked.
ref-docs/raw/**
!ref-docs/raw/README.md

# Antigravity PR reviewer: large-diff on-disk handoff (transient, removed by the script).
/.agy-review-work/

# Local release and test bundles (store packages, unpacked builds, guides) assembled by hand or by
# another agent session. Built from the repository; never committed.
/release-builds/
/test-builds/
